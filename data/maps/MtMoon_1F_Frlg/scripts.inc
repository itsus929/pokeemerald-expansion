MtMoon_1F_Frlg_EventScript_CardioGirl::
    lock
    faceplayer
    msgbox MtMoon_1F_Frlg_Text_CardioGirl, MSGBOX_DEFAULT
    release
    end


MtMoon_1F_Frlg_EventScript_ConfusedClefairy::
    lock
    faceplayer
    msgbox MtMoon_1F_Frlg_Text_ConfusedClefairy, MSGBOX_DEFAULT
    release
    end


MtMoon_1F_Frlg_Text_CardioGirl:
    .string "I've been doing laps around this\n"
    .string "Clefairy for exercise.\p"
    .string "It hasn't moved once.\p"
    .string "I think it's judging my form.$"


MtMoon_1F_Frlg_Text_ConfusedClefairy:
    .string "CLEFAIRY: ...Clefairy?$"

